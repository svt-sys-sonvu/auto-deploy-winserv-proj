# Document ref: https://servermanagementportal.ext.hpe.com/docs/references_and_material/blogposts/firmware_updates/part3/firmware_update_part3
# Doc ref: https://servermanagementportal.ext.hpe.com/docs/redfishservices/ilos/supplementdocuments/updateservice
---
- name: Fail if SPP update requested but no filename provided
  ansible.builtin.fail:
    msg: "update_fw_via_spp is true but spp_file_name is empty - set spp_file_name or disable update_fw_via_spp"
  when:
    - update_fw_via_spp | bool
    - not spp_file_name

- name: Create Redfish credentials access token
  community.general.redfish_command:
    category: Sessions
    command: CreateSession
    baseuri: "{{ hpe_server.dhcp_ipv4 }}"
    username: "{{ hpe_server.ilo_user_default | default('Administrator') }}"
    password: "{{ new_ilo_admin_password }}"
  register: redfish_login_token

- name: Set Fact for Redfish credentials access token
  ansible.builtin.set_fact:
    ilo_x_auth_token: "{{ redfish_login_token.session.token }}"
    ilo_x_uri: "{{ redfish_login_token.session.uri }}"

- name: Verify Redfish session token exists
  ansible.builtin.assert:
    that:
      - ilo_x_auth_token is defined
      - ilo_x_auth_token | length > 0
    fail_msg: "Redfish authentication token is missing."

- name: Stage BIOS Firmware via Redfish SimpleUpdate from local file
  ansible.builtin.uri:
    url: "https://{{ hpe_server.permanent_ipv4 }}/redfish/v1/UpdateService/Actions/UpdateService.SimpleUpdate/"
    validate_certs: "{{ ilo_validate_certs | default(false) | bool }}"
    method: POST
    status_code: [200, 201, 202]
    return_content: yes
    headers:
      Content-Type: "application/json"
      X-Auth-Token: "{{ ilo_x_auth_token }}"
    body_format: json 
    body:
      ImageURI: "{{ bios_fw_path }}"
  register: bios_fw_update
  when:
    - bios_fw_path is defined
    - bios_fw_path.endswith('.signed.flash')

- name: Waiting for BIOS upload to complete
  ansible.builtin.uri:
    url: "https://{{ hpe_server.permanent_ipv4 }}/redfish/v1/UpdateService/"
    validate_certs: "{{ ilo_validate_certs | default(false) | bool }}"
    method: GET
    status_code: [200, 202]
    headers:
      Content-Type: "application/json"
      X-Auth-Token: "{{ ilo_x_auth_token }}"
    body_format: json 
  register: bios_upload_status
  until: bios_upload_status.json.Oem.Hpe.State is defined and bios_upload_status.json.Oem.Hpe.State in ['Complete']
  retries: 15
  delay: 30
  when:
    - bios_fw_update is not skipped
    - bios_fw_update.status in [200, 201, 202]

- name: Reboot server to apply BIOS update
  ansible.builtin.uri:
    url:  "https://{{ hpe_server.permanent_ipv4 }}/redfish/v1/Systems/1/Actions/ComputerSystem.Reset/" 
    validate_certs: "{{ ilo_validate_certs | default(false) | bool }}"
    method: "POST"
    status_code: [200, 202]
    headers:
      Content-Type: "application/json"
      X-Auth-Token: "{{ ilo_x_auth_token }}"
    body_format: json
    body:
      ResetType: "GracefulRestart"                # GracefulRestart if an OS is currently running
  when: 
    - bios_fw_update is not skipped
    - bios_fw_update.status in [200, 201, 202]

- name: Stage iLO Firmware via Redfish SimpleUpdate
  ansible.builtin.uri:
    url: "https://{{ hpe_server.permanent_ipv4 }}/redfish/v1/UpdateService/Actions/UpdateService.SimpleUpdate/" 
    validate_certs: "{{ ilo_validate_certs | default(false) | bool }}"
    method: "POST"
    status_code: [200, 202]
    headers:
      Content-Type: "application/json"
      X-Auth-Token: "{{ ilo_x_auth_token }}"
    body_format: json
    body:
      ImageURI: "{{ ilo_fw_path }}"
  register: ilo_fw_update
  when: ilo_fw_path is defined and ilo_fw_path.endswith('.bin')

- name: Wait for iLO to reboot after flash firmware
  ansible.builtin.wait_for:
    host: "{{ hpe_server.permanent_ipv4 }}"
    port: 443
    delay: 45 
    timeout: 600
  when: 
  - ilo_fw_update.status in [200, 201, 202]
  - ilo_fw_update is not skipped

- name: Verify status of BIOS after flash firmware
  ansible.builtin.uri:
    url: "https://{{ hpe_server.permanent_ipv4 }}/redfish/v1/Systems/1/" 
    user: "{{ ilo_username | default('Administrator') }}"
    password: "{{ new_ilo_admin_password }}"
    validate_certs: "{{ ilo_validate_certs | default(false) | bool }}"
    method: "GET"
    status_code: [200, 202]
    force_basic_auth: yes
    headers:
      Content-Type: "application/json"
    body_format: json
  when:
    - bios_fw_update is not skipped
    - bios_fw_update.status in [200, 201, 202]
  register: bios_status
  until:
  - bios_status.json.Oem.Hpe.AggregateHealthStatus.BiosOrHardwareHealth.Status.Health is defined
  - bios_status.json.Oem.Hpe.AggregateHealthStatus.BiosOrHardwareHealth.Status.Health in ['OK']
  retries: 30
  delay: 30

- name: Perform update iLO firmware via Service Pack for ProLiant
  when: update_fw_via_spp is true 
  block:
    - name: Create Redfish credentials access token
      community.general.redfish_command:
        category: Sessions
        command: CreateSession
        baseuri: "{{ hpe_server.dhcp_ipv4 }}"
        username: "{{ hpe_server.ilo_user_default | default('Administrator') }}"
        password: "{{ new_ilo_admin_password }}"
      register: redfish_login_token

    - name: Set Fact for Redfish credentials access token
      ansible.builtin.set_fact:
        ilo_x_auth_token: "{{ redfish_login_token.session.token }}"
        ilo_x_uri: "{{ redfish_login_token.session.uri }}"

    - name: Verify Redfish session token exists
      ansible.builtin.assert:
        that:
          - ilo_x_auth_token is defined
          - ilo_x_auth_token | length > 0
        fail_msg: "Redfish authentication token is missing."

    - name: Insert virtual media (CD/DVD) via Redfish
      community.general.redfish_command:
        category: Manager
        command: VirtualMediaInsert
        baseuri: "{{ hpe_server.permanent_ipv4 }}"
        auth_token: "{{ ilo_x_auth_token }}"
        virtual_media:
          image_url: "{{ spp_iso_path }}"
          media_types:
            - CD
            - DVD
      register: insert_virtual_media

    - name: Set one-time boot to CD via Redfish
      community.general.redfish_command:
        category: Systems
        command: SetOneTimeBoot
        baseuri: "{{ hpe_server.permanent_ipv4 }}"
        username: "{{ ilo_username | default('Administrator') }}"
        password: "{{ new_ilo_admin_password }}"
        boot_source_override_target: "Cd"
        resource_id: "1"
      register: boot_cdrom
      when:
      - insert_virtual_media.changed
      - insert_virtual_media is not skipped

    - name: Request restart to apply boot CDROM
      community.general.redfish_command:
        category: Systems
        command: PowerGracefulRestart
        baseuri: "{{ hpe_server.dhcp_ipv4 }}"
        auth_token: "{{ ilo_x_auth_token }}"
      when:
      - (boot_cdrom.changed) or (boot_cdrom is defined)
      - (insert_virtual_media.changed) or (insert_virtual_media is defined)
      - insert_virtual_media is not skipped

