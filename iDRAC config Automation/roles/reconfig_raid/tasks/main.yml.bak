---
- name: Gathering current storage controller config
  dellemc.openmanage.idrac_storage_volume:
    idrac_ip: "{{ server.static_ip }}"
    idrac_user: "{{ server.username }}"
    idrac_port: "{{ target_idrac_port }}"
    idrac_password: "{{ server.temp_passwd }}"
    validate_certs: "{{ validate_certs }}"
    state: "view"
  register: storage_info
  no_log: true

- name: Extract controllers with "RAID" in their names using regex
  set_fact:
    raid_controllers: "{{ storage_info.storage_status.Message.Controller | dict2items | selectattr('key', 'search', 'RAID') | map(attribute='key') | list }}"

- name: Assert RAID controller exists
  ansible.builtin.assert:
    that:
      - raid_controllers is defined
      - raid_controllers | length > 0
    fail_msg: "CRITICAL: No RAID controller found on server {{ server.service_tag }}."

- name: Show the Storage Controller will use 
  ansible.builtin.debug:
    msg: "Selected RAID Controller: {{ raid_controllers[0] }}"
    #var: raid_controllers

- name: Detect and extract the virtual disks associated with each RAID controller
  set_fact:
    virtual_disks: "{{ virtual_disks | default({}) | combine({ item: storage_info.storage_status.Message.Controller[item].VirtualDisk | dict2items | map(attribute='key') | list }) }}"
  loop: "{{ raid_controllers }}"
  loop_control:
    label: "{{ item }}"

- name: Show Virtual Disk Name will be removed
  debug:
    var: virtual_disks

- name: Flatten the virtual disks into a list for removal
  set_fact:
    flat_virtual_disks: "{{ virtual_disks | dict2items | map(attribute='value') | sum(start=[]) }}"

- debug: 
    var: flat_virtual_disks

- name: Get drive inventory
  community.general.redfish_info:
    category: Systems
    command: GetDiskInventory
    baseuri: "{{ server.static_ip }}"
    username: "{{ server.username }}"
    password: "{{ server.temp_passwd }}"
  register: disk_results

# - name: Set fact with all raw physical drives
#   set_fact:
#     all_physical_drives: "{{ disk_results.redfish_facts.disk.entries[0][1] | map(attribute='Drives') | flatten }}"

# - name: Show the extracted all physical drives
#   debug:
#     var: all_physical_drives

# - name: Get only SSD drives only
#   set_fact:
#     ssd_only_drives: "{{ all_physical_drives | selectattr('MediaType', 'equalto', 'SSD') | list }}"

# - name: Show the SSD drives only 
#   debug:
#     var: ssd_only_drives

- name: Extract IDs of all SSD drives
  set_fact:
    ssd_drive_ids: "{{ disk_results.redfish_facts.disk.entries[0][1] | map(attribute='Drives') | flatten | selectattr('MediaType', 'equalto', 'SSD') | map(attribute='Id') | list }}"

- name: Show the isolated SSD IDs
  debug:
    var: ssd_drive_ids

- name: Create a RAID1 on PERC controller with SSD Drives
  dellemc.openmanage.idrac_storage_volume:
    idrac_ip: "{{ server.static_ip }}"
    idrac_user: "{{ server.username }}"
    idrac_port: "{{ target_idrac_port }}"
    idrac_password: "{{ server.temp_passwd }}"
    validate_certs: "{{ validate_certs }}"

    state: "create"
    controller_id: "{{ raid_controllers[0] }}"
    volume_type: "RAID 1"
    span_depth: 1
    span_length: "{{ raid_expected_os_disk_count }} "
    #number_dedicated_hot_spare: 1
    disk_cache_policy: "{{ disk_cache_policy }}"
    write_cache_policy: "{{ write_cache_policy }}"
    read_cache_policy: "{{ read_cache_policy }}"
    stripe_size: "{{ os_stripe_size }}"
    raid_init_operation: "Fast"
    volumes:
      - name: "Raid1-OS-Volume"
        drives:
          id: "{{ ssd_drive_ids }}" 
    
    raid_reset_config: "true"
    job_wait: true 
    time_to_wait: 300
    timeout: 60
    job_wait_timeout: 1200


- name: Perform restart device for importing storage config job
  dellemc.openmanage.redfish_powerstate:
    baseuri: "{{ server.static_ip }}:{{ target_idrac_port }}"
    username: "{{ server.username }}"
    password: "{{ server.temp_passwd }}"
    validate_certs: "{{ validate_certs }}"
    reset_type: "ForceRestart"

