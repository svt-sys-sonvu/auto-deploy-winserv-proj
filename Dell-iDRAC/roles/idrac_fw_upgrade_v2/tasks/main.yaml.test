- name: "Check the current power state of the server"
  ansible.builtin.uri:
    url: "https://{{ server.permanent_ip }}/redfish/v1/Systems/System.Embedded.1"
    user: "{{ server.username }}"
    password: "{{ idrac_root_passwd }}"
    validate_certs: "{{ validate_certs }}"
    method: "GET"
    use_proxy: yes
    force_basic_auth: yes
    return_content: yes
  register: server_status

- name: "Power off the server (Skipped if already OFF) before upgrade BIOS firmware"
  dellemc.openmanage.redfish_powerstate:
    baseuri: "{{ server.permanent_ip }}:{{ target_idrac_port }}"
    username: "{{ server.username }}"
    password: "{{ idrac_root_passwd }}"
    validate_certs: "{{ validate_certs }}"
    reset_type: "GracefulShutdown"
  when: server_status.json.PowerState == 'On'

- name: "Upload the PERC firmware from local path"
  dellemc.openmanage.redfish_firmware:
    baseuri: "{{ server.permanent_ip }}:{{ target_idrac_port }}"
    username: "{{ server.username }}"
    password: "{{ idrac_root_passwd }}"
    validate_certs: "{{ validate_certs }}"

    image_uri: "{{ perc_firmware }}"
    job_wait: false
  register: perc_upgrade_result

- name: "Track PERC upload job to completion"
  ansible.builtin.uri:
    url: "https://{{ server.permanent_ip }}/redfish/v1/TaskService/Tasks/{{ perc_upgrade_result.task.id }}"
    user: "{{ server.username }}" 
    password: "{{ idrac_root_passwd }}"
    validate_certs: "{{ validate_certs }}"

    method: "GET"
    use_proxy: yes
    status_code: 200, 202
    return_content: yes
    force_basic_auth: yes
    headers:
      Content-Type: "application/json"
      Accept: "application/json"
  register: perc_job_result
  until: perc_job_result.json.TaskState == 'Completed' or perc_job_result.json.TaskState == 'Starting'
  retries: "{{ retries_count }}"
  delay: "{{ polling_interval }}"

- name: "Reboot the server to update BIOS firmware"
  ansible.builtin.uri:
    url: "https://{{ server.permanent_ip }}{{ reboot_uri }}"
    user: "{{ server.username }}" 
    password: "{{ idrac_root_passwd }}"
    validate_certs: "{{ validate_certs }}"

    method: "POST"
    body_format: raw
    body: '{"ResetType": "On"}'
    use_proxy: yes
    status_code: 204
    return_content: no
    force_basic_auth: yes
    headers:
      Content-Type: "application/json"
      Accept: "application/json"
  register: perc_reboot_result
  changed_when: perc_reboot_result.status == 204
  when: perc_job_result.json.TaskState == 'Starting' and perc_job_result.json.Messages.0.Message == 'Task successfully scheduled.'

- name: "Wait 5 mins for PERC firmware to be applied"
  wait_for:
    timeout: 180
  when: perc_job_result.json.TaskState == 'Starting' and perc_job_result.json.Messages.0.Message == 'Task successfully scheduled.'

- name: "Track PERC firmware update job"
  ansible.builtin.uri:
    url: "https://{{ server.permanent_ip }}/redfish/v1/TaskService/Tasks/{{ perc_upgrade_result.task.id }}"
    user: "{{ server.username }}" 
    password: "{{ idrac_root_passwd }}"
    validate_certs: "{{ validate_certs }}"

    method: "GET"
    use_proxy: yes
    status_code: 200, 202
    return_content: yes
    force_basic_auth: yes
    headers:
      Content-Type: "application/json"
      Accept: "application/json"
  register: perc_final_result
  until: perc_final_result.json.TaskState == 'Completed' or perc_final_result.json.TaskState == 'Starting'
  retries: "{{ retries_count }}"
  delay: "{{ polling_interval }}"