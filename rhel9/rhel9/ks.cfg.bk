# Generated by Anaconda 34.25.4.9
# Generated by pykickstart v3.32
#version=RHEL9
# Use graphical install
text
repo --name="AppStream" --baseurl=file:///run/install/sources/mount-0000-cdrom/AppStream

%addon com_redhat_kdump --enable --reserve-mb='auto'

%end

# Keyboard layouts
keyboard --xlayouts='us'
# System language
lang en_US.UTF-8

# Use CDROM installation media
cdrom

%packages
@^minimal-environment

%end

# Run the Setup Agent on first boot
firstboot --enable
# Partition clearing information
zerombr
clearpart --all --initlabel

# Generated using Blivet version 3.6.0
ignoredisk --only-use=sda

# Disk partitioning information
part /boot --fstype="xfs" --ondisk=sda --size=1024
part pv.166 --fstype="lvmpv" --ondisk=sda --size=509950
part /boot/efi --fstype="efi" --ondisk=sda --size=1024 --fsoptions="umask=0077,shortname=winnt"
volgroup vg_rhel --pesize=4096 pv.166
logvol /var --fstype="xfs" --size=51200 --name=var --vgname=vg_rhel
logvol / --fstype="xfs" --size=102400 --name=root --vgname=vg_rhel
logvol /u01 --fstype="ext4" --size=325623 --name=u01 --vgname=vg_rhel
logvol /home --fstype="xfs" --size=30720 --name=home --vgname=vg_rhel

# System timezone
timezone Asia/Ho_Chi_Minh --utc

# Root password
rootpw --iscrypted $6$6M/LrUVu2W0AtS.u$kdgZ00e5rWOX3JG/5v3if8IzRowjWEMObJYKOD7lc/t24ScO/4gQzQjXs90qv2bxfNgafseBwFWjS36prY7WB1

# Disable SELinux
selinux --disabled

# Firewall configuration
firewall --disabled

%post --interpreter=/bin/bash --log=/var/log/post-script.log --nochroot

# Mount the CD-ROM
mkdir -p /mnt/sysimage/mnt/cdrom
mount /dev/sr0 /mnt/sysimage/mnt/cdrom

# Retrieve configuration based on serial number
SERIAL=$(dmidecode -s system-serial-number)
CONFIG=$(grep "^$SERIAL" /mnt/sysimage/mnt/cdrom/ip_config.csv)
HOST_NAME=$(echo "$CONFIG" | cut -d',' -f2)
BOND1_IP=$(echo "$CONFIG" | cut -d',' -f3)
BOND2_IP=$(echo "$CONFIG" | cut -d',' -f4)

# Log the values for debugging
echo "Serial: $SERIAL" > /mnt/sysimage/var/log/kickstart-debug.log
echo "Config: $CONFIG" >> /mnt/sysimage/var/log/kickstart-debug.log
echo "Host Name: $HOST_NAME" >> /mnt/sysimage/var/log/kickstart-debug.log
echo "Bond1 IP: $BOND1_IP" >> /mnt/sysimage/var/log/kickstart-debug.log
echo "Bond2 IP: $BOND2_IP" >> /mnt/sysimage/var/log/kickstart-debug.log

# Apply network configuration using nmcli
nmcli connection add type bond con-name bond0 ifname bond0 bond.options "mode=1,miimon=100" 802-3-ethernet.mtu 1500 connection.autoconnect-slaves yes connection.autoconnect yes
nmcli connection add type ethernet slave-type bond con-name bond0-port1 ifname eno1 master bond0 connection.autoconnect yes
nmcli connection add type ethernet slave-type bond con-name bond0-port2 ifname ens3 master bond0 connection.autoconnect yes
nmcli con mod bond0 ipv6.method disabled
nmcli con mod bond0 ipv4.addresses $BOND1_IP ipv4.gateway 10.1.0.1 ipv4.dns "8.8.8.8 8.8.4.4" ipv4.method manual
nmcli con up bond0

nmcli connection add type bond con-name bond1 ifname bond1 bond.options "mode=4,miimon=100,xmit_hash_policy=layer3+4,lacp_rate=1" 802-3-ethernet.mtu 1500 connection.autoconnect-slaves yes connection.autoconnect yes
nmcli connection add type ethernet slave-type bond con-name bond1-port1 ifname eno2 master bond1 connection.autoconnect yes
nmcli connection add type ethernet slave-type bond con-name bond1-port2 ifname ens4 master bond1 connection.autoconnect yes
nmcli con mod bond1 ipv6.method disabled
nmcli con mod bond1 ipv4.addresses $BOND2_IP ipv4.gateway 10.3.209.1 ipv4.dns "172.31.20.10 172.31.20.11" ipv4.method manual
nmcli con up bond1

hostnamectl set-hostname $HOST_NAME

%end


reboot
